# Normalize text while preserving binary skill assets.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf
*.md text
*.py text
*.js text
*.ts text
*.json text
*.toml text
*.yaml text
*.yml text
*.lock text
*.svg text

